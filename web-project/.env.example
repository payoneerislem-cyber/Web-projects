APP_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret
# DATABASE_PATH and UPLOAD_FOLDER are optional. Relative paths are resolved from the project root.
DATABASE_PATH=./instance/budget_tracker.db
UPLOAD_FOLDER=./app/static/uploads
SESSION_COOKIE_SECURE=0
MAX_CONTENT_LENGTH=5242880

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
MAIL_USE_TLS=1
OTP_TTL_SECONDS=600

# Set to 1 only when the app is behind a trusted reverse proxy.
TRUST_PROXY=0
