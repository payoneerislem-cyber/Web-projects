# Change this to a long random value before public deployment.
SECRET_KEY=
FLASK_DEBUG=0
COOKIE_SECURE=0

# Public canonical URL, e.g. https://your-domain.com
SITE_URL=

# The inbox for project enquiries
CONTACT_EMAIL=islemislem5560@gmail.com

# Optional SMTP settings. With Gmail, use an App Password, not your account password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Required to enable the password-protected feedback moderation page. Use a strong unique password.
FEEDBACK_ADMIN_PASSWORD=

# Optional real payment/donation URL (PayPal donation page, Ko-fi, Buy Me a Coffee, etc.).
# Leave blank until you have created your own payment destination.
SUPPORT_URL=

# Optional persistent database path. On hosts with a persistent disk, point this to its mount path.
# Example for a disk mounted at /var/data: PORTFOLIO_DB_PATH=/var/data/portfolio.sqlite3
PORTFOLIO_DB_PATH=

# Optional social profile
LINKEDIN_URL=
