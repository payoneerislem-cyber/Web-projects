# Local development settings. Copy to .env and change both secrets.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=change-this-local-admin-password
DATABASE_PATH=instance/noor.sqlite3
SEED_DEMO_DATA=true
STUDIO_NAME=NOOR Studio
PUBLIC_PHONE=0550 00 00 00
PUBLIC_EMAIL=hello@example.test
PUBLIC_CITY=Mascara, Algeria
COOKIE_SECURE=false
BUSINESS_TIMEZONE=Africa/Algiers
# Optional SMTP notifications; leave unset to store bookings without email notifications.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_TO=
