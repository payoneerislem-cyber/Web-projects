# Local development settings. Copy this file to .env and change the secret/password.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=change-this-local-admin-password
DATABASE_PATH=instance/madar.sqlite3
SEED_DEMO_DATA=true
BUSINESS_NAME_AR=مَدار
BUSINESS_NAME_EN=MADAR
PUBLIC_PHONE=0550 00 00 00
PUBLIC_EMAIL=bonjour@example.test
PUBLIC_CITY=Mascara, Algeria
COOKIE_SECURE=false
BUSINESS_TIMEZONE=Africa/Algiers
# Optional email notifications. Leave unset to save requests without email notifications.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_TO=
